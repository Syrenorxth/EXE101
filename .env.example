# ===== Cấu hình AI cho PalSpeak =====
# Sao chép file này thành ".env" rồi điền API key.
# Không có key thì app vẫn chạy ở "Chế độ demo" (chấm điểm theo quy tắc, không dùng AI).
# Key chỉ nằm ở máy chủ dev của Vite, không lộ ra trình duyệt.
# Khi đưa lên Cloudflare Pages: không dùng file này, đặt các biến dưới đây trong
# Settings > Variables and Secrets của dự án (AI_API_KEY để dạng Secret).

# --- Cách 1: OpenAI ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Cách 2: Google Gemini (có gói miễn phí, dùng endpoint tương thích OpenAI) ---
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-2.0-flash
